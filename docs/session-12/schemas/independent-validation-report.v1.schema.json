{
  "$defs": {
    "ObservationAudit": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "spec_id": {
          "title": "Spec Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "discovery",
            "selection",
            "validation",
            "replay"
          ],
          "title": "Split",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "training_reference",
            "included_validation",
            "excluded"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "spec_id",
        "split",
        "disposition",
        "reason"
      ],
      "title": "ObservationAudit",
      "type": "object"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "spec_id": {
          "title": "Spec Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "validated",
            "rejected",
            "inconclusive",
            "invalidated"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "candidate_kind": {
          "anyOf": [
            {
              "enum": [
                "main_effect",
                "interaction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Kind"
        },
        "target_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Metric"
        },
        "target_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Unit"
        },
        "pair_count": {
          "minimum": 0,
          "title": "Pair Count",
          "type": "integer"
        },
        "mean_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Effect"
        },
        "sample_sd_effect": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Sd Effect"
        },
        "confidence_interval_95_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval 95 Low"
        },
        "confidence_interval_95_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval 95 High"
        },
        "concordant_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concordant Fraction"
        },
        "effect_retention_fraction": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Retention Fraction"
        },
        "validated_scenarios": {
          "items": {
            "type": "string"
          },
          "title": "Validated Scenarios",
          "type": "array"
        },
        "distinct_initial_states": {
          "minimum": 0,
          "title": "Distinct Initial States",
          "type": "integer"
        },
        "distinct_task_patterns": {
          "minimum": 0,
          "title": "Distinct Task Patterns",
          "type": "integer"
        },
        "distinct_workload_patterns": {
          "minimum": 0,
          "title": "Distinct Workload Patterns",
          "type": "integer"
        },
        "replicate_effects": {
          "items": {
            "type": "number"
          },
          "title": "Replicate Effects",
          "type": "array"
        },
        "criteria_snapshot": {
          "additionalProperties": true,
          "title": "Criteria Snapshot",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "spec_id",
        "status",
        "reason",
        "pair_count",
        "validated_scenarios",
        "distinct_initial_states",
        "distinct_task_patterns",
        "distinct_workload_patterns",
        "replicate_effects",
        "criteria_snapshot",
        "evidence_ids"
      ],
      "title": "ValidationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^valreport-[0-9a-f]{24}$",
      "title": "Report Id",
      "type": "string"
    },
    "status": {
      "const": "independent_validation_report",
      "default": "independent_validation_report",
      "title": "Status",
      "type": "string"
    },
    "validation_config_id": {
      "title": "Validation Config Id",
      "type": "string"
    },
    "validation_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Config Sha256",
      "type": "string"
    },
    "candidate_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Report Sha256",
      "type": "string"
    },
    "observation_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Input Sha256",
      "type": "string"
    },
    "training_splits_excluded_from_estimation": {
      "default": [
        "discovery",
        "selection"
      ],
      "items": {
        "enum": [
          "discovery",
          "selection"
        ],
        "type": "string"
      },
      "title": "Training Splits Excluded From Estimation",
      "type": "array"
    },
    "replay_excluded_from_estimation": {
      "default": true,
      "title": "Replay Excluded From Estimation",
      "type": "boolean"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ValidationResult"
      },
      "maxItems": 25,
      "title": "Results",
      "type": "array"
    },
    "audit": {
      "items": {
        "$ref": "#/$defs/ObservationAudit"
      },
      "maxItems": 100000,
      "title": "Audit",
      "type": "array"
    },
    "overall_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Overall Limitations",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "validation_config_id",
    "validation_config_sha256",
    "candidate_report_sha256",
    "observation_input_sha256",
    "results",
    "audit",
    "overall_limitations"
  ],
  "title": "IndependentValidationReport",
  "type": "object"
}
