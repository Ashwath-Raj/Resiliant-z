{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resiliant-z.invalid/schemas/orchestration-config.v1.schema.json",
  "title": "RESILIANT-Z Session 9 Orchestration Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_id", "max_runs_per_invocation", "allowed_executor_kinds", "allow_execution", "allow_remote_execution", "journal_max_bytes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "config_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "max_runs_per_invocation": {"type": "integer", "minimum": 1, "maximum": 200},
    "allowed_executor_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local", "nebius_jobs"]}},
    "allow_execution": {"type": "boolean"},
    "allow_remote_execution": {"type": "boolean"},
    "journal_max_bytes": {"type": "integer", "minimum": 1024, "maximum": 268435456}
  },
  "allOf": [
    {"if": {"properties": {"allow_remote_execution": {"const": false}}, "required": ["allow_remote_execution"]}, "then": {"properties": {"allowed_executor_kinds": {"not": {"contains": {"const": "nebius_jobs"}}}}}},
    {"if": {"properties": {"allow_remote_execution": {"const": true}}, "required": ["allow_remote_execution"]}, "then": {"properties": {"allowed_executor_kinds": {"contains": {"const": "nebius_jobs"}}}}}
  ]
}
