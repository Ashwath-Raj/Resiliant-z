{
  "additionalProperties": false,
  "description": "Trusted, predeclared analysis bounds; not generated by a hypothesis provider.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "config_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Config Id",
      "type": "string"
    },
    "primary_split": {
      "const": "validation",
      "default": "validation",
      "title": "Primary Split",
      "type": "string"
    },
    "expected_metric_unit": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Expected Metric Unit",
      "type": "string"
    },
    "metric_min_value": {
      "title": "Metric Min Value",
      "type": "number"
    },
    "metric_max_value": {
      "title": "Metric Max Value",
      "type": "number"
    },
    "minimum_pairs": {
      "default": 3,
      "maximum": 25,
      "minimum": 2,
      "title": "Minimum Pairs",
      "type": "integer"
    },
    "minimum_practical_effect": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Minimum Practical Effect",
      "type": "number"
    },
    "confidence_level": {
      "const": 0.95,
      "default": 0.95,
      "title": "Confidence Level",
      "type": "number"
    },
    "max_plan_bytes": {
      "default": 1048576,
      "maximum": 8388608,
      "minimum": 1024,
      "title": "Max Plan Bytes",
      "type": "integer"
    },
    "max_receipt_bytes": {
      "default": 16777216,
      "maximum": 268435456,
      "minimum": 1024,
      "title": "Max Receipt Bytes",
      "type": "integer"
    },
    "max_result_bytes": {
      "default": 1048576,
      "maximum": 16777216,
      "minimum": 256,
      "title": "Max Result Bytes",
      "type": "integer"
    },
    "max_runs": {
      "default": 200,
      "maximum": 200,
      "minimum": 2,
      "title": "Max Runs",
      "type": "integer"
    },
    "max_receipts": {
      "default": 200,
      "maximum": 200,
      "minimum": 1,
      "title": "Max Receipts",
      "type": "integer"
    }
  },
  "required": [
    "config_id",
    "expected_metric_unit",
    "metric_min_value",
    "metric_max_value"
  ],
  "title": "Session10Config",
  "type": "object"
}
