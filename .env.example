# Optional. Without these values, the local demo runs without external API calls.
# Create a key in Nebius Token Factory; do not use a cloud IAM token here.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Set this to an exact model ID visible in your Token Factory model catalogue.
NEBIUS_MODEL=
NEBIUS_TIMEOUT_SECONDS=45

# Server
RESILIANT_HOST=127.0.0.1
RESILIANT_PORT=8000
